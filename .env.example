# Gemini - Vercel Environment Variable
GEMINI_API_KEY=

# Firebase client configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# M-PESA server-side configuration
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Firebase server-side access
FIREBASE_WEB_API_KEY=
# Download a service-account JSON for this Firebase project.
# Keep this entire JSON value server-side in Vercel; never prefix it with VITE_.
FIREBASE_SERVICE_ACCOUNT_JSON=

# PayHero M-PESA STK Push (server-side only; no credentials in frontend code)
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=https://shambavet.vercel.app/api/payhero-callback

# Browser Web Push (generate a VAPID key pair; keep private key server-side)
VITE_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@shambavet.co.ke

# Meta WhatsApp Business Cloud API (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v27.0
