rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'developer';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /farmerProfiles/{uid} {
      // Farmers may only manage their own profile document; admins may inspect/manage profiles.
      allow create, read, update, delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Agrovet / agricultural supplier onboarding and self-managed product listings.
    match /agrovetApplications/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.shopName is string
        && request.resource.data.phone is string;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /marketplaceProducts/{id} {
      function approvedSupplier() {
        return signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.applicationId is string
          && exists(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId))
          && get(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId)).data.status == 'approved';
      }
      allow read: if (resource.data.status == 'approved' && resource.data.available == true) || isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      // Only an approved supplier can publish directly to the public marketplace.
      allow create: if isAdmin() || (approvedSupplier()
        && request.resource.data.status == 'approved'
        && request.resource.data.available == true
        && request.resource.data.name is string
        && request.resource.data.category is string);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.applicationId is string
        && request.resource.data.status == 'approved'
        && request.resource.data.available is bool
        && exists(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId))
        && get(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId)).data.status == 'approved');
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /organizationApplications/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /organizations/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /farmerOrganizationRequests/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.message is string;
      allow read: if isAdmin() || (signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.organizationOwnerUid == request.auth.uid));
      allow update: if isAdmin() || (signedIn() &&
        resource.data.organizationOwnerUid == request.auth.uid &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /fieldVisitReports/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.topic is string
        && request.resource.data.county is string;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /trainingEvents/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /trainingRegistrations/{id} {
      allow create: if signedIn() && request.resource.data.farmerUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.farmerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /farmProjectRequests/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /expertVisitRequests/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /veterinarians/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /vetApplications/{id} {
      allow create: if request.resource.data.fee == 250 && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.phone is string
        && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
