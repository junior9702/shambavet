rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'developer';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /farmerProfiles/{uid} {
      // Farmers may only manage their own profile document; admins may inspect/manage profiles.
      allow create, read, update, delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Public farmer map pins contain only non-sensitive location-directory fields.
    // The private farmerProfiles document is never made publicly readable.
    match /farmerLocations/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.locationVisible == true
        && request.resource.data.lat is string
        && request.resource.data.lng is string;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Agrovet / agricultural supplier onboarding and self-managed product listings.
    // Public map directory contains only approved shop location and contact fields.
    match /agrovetLocations/{id} {
      allow read: if true;
      allow create, update: if isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/agrovetApplications/$(id))
        && get(/databases/$(database)/documents/agrovetApplications/$(id)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/agrovetApplications/$(id)).data.status == 'approved'
        && request.resource.data.shopName is string
        && request.resource.data.shopLat is string
        && request.resource.data.shopLng is string);
      allow delete: if isAdmin();
    }

    match /agrovetApplications/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.shopName is string
        && request.resource.data.phone is string;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && (resource.data.status == 'pending' || resource.data.status == 'approved')
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }


    // Farmer-supplied feed ingredients are moderated before public marketplace visibility.
    match /feedIngredientListings/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.county is string
        && request.resource.data.phone is string
        && request.resource.data.category == 'Animal feeds';
      allow read: if resource.data.status == 'approved' || isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'pending');
    }

    match /marketplaceProducts/{id} {
      function approvedSupplier() {
        return signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.applicationId is string
          && exists(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId))
          && get(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId)).data.status == 'approved';
      }
      allow read: if resource.data.status == 'approved' || isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      // Only an approved supplier can publish directly to the public marketplace.
      allow create: if isAdmin() || (approvedSupplier()
        && request.resource.data.status == 'approved'
        && request.resource.data.available == true
        && request.resource.data.name is string
        && request.resource.data.category is string);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.applicationId is string
        && request.resource.data.status == 'approved'
        && request.resource.data.available is bool
        && exists(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId))
        && get(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/agrovetApplications/$(request.resource.data.applicationId)).data.status == 'approved');
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /organizationApplications/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /organizations/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /farmerOrganizationRequests/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.message is string;
      allow read: if isAdmin() || (signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.organizationOwnerUid == request.auth.uid));
      allow update: if isAdmin() || (signedIn() &&
        resource.data.organizationOwnerUid == request.auth.uid &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /fieldVisitReports/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.topic is string
        && request.resource.data.county is string;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Learning Academy content is public only after an administrator publishes a course.
    // Only approved ShambaVet developers can create or edit course, module, lesson and quiz content.
    match /academyCourses/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /trainingEvents/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /trainingRegistrations/{id} {
      allow create: if signedIn() && request.resource.data.farmerUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.farmerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /farmProjectRequests/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /expertVisitRequests/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Farmer consultation requests: farmers may submit and read only their own requests.
    // Only an enabled ShambaVet developer administrator may review or change request status.
    match /vetAppointments/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.vetId is string
        && request.resource.data.vetName is string
        && request.resource.data.farmerPhone is string
        && request.resource.data.preferredDate is string
        && request.resource.data.serviceType is string
        && request.resource.data.issue is string
        && request.resource.data.issue.size() > 0
        && request.resource.data.issue.size() <= 1500;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'submitted');
    }

    match /veterinarians/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /vetApplications/{id} {
      allow create: if request.resource.data.fee == 250 && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.phone is string
        && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // Platform notifications: public event announcements, private recipient alerts and admin operational alerts.
    match /platformNotifications/{id} {
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.audience in ['all', 'admins']
        && (request.resource.data.audience == 'admins' || isAdmin())
        && request.resource.data.read == false;
      allow read: if (resource.data.audience == 'all')
        || (signedIn() && resource.data.recipientUid == request.auth.uid)
        || isAdmin();
      allow update: if isAdmin()
        || (signedIn() && resource.data.recipientUid == request.auth.uid
          && request.resource.data.recipientUid == resource.data.recipientUid
          && request.resource.data.actorUid == resource.data.actorUid);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.recipientUid == request.auth.uid);
    }

    // Payment, certificate and AI entitlements are written only by trusted server endpoints.
    // Learners can read only their own records; browser clients cannot grant themselves credit or completion.
    match /academyProgress/{uid}/courses/{courseId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /aiAccounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /certificateEntitlements/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /payheroPayments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
